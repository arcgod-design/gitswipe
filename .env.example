# Jarvis configuration example.
# Copy to .env for local overrides. NEVER commit .env — it is gitignored.

# --- Workstation daemon (SERVER/WORKSTATION CONFIG) ---
JARVIS_BIND=127.0.0.1
JARVIS_PORT=7420
JARVIS_LOG_LEVEL=info
JARVIS_DATA_DIR=./data

# --- GitHub (user-owned, least privilege; WEEK-02 wires the OAuth flow) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- BYOK AI providers (SECRETS — stay on this machine, never in git/logs) ---
# A key here is a dev convenience only; production path is the OS credential
# store via the credential broker (WEEK-07).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Local models (no key required by default) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Puter (optional; core flow never requires it) ---
PUTER_APP_UID=
PUTER_APP_JS_ORIGIN=https://js.puter.com/v2/
